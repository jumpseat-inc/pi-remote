node_modules/

# macOS
.DS_Store

# pi harness + transient state (pi-council, pi-remote)
.pi/git/
.pi/council/.pids.json
.pi/council/gate-ledger.jsonl
.pi/council/tooling-drift.state.json
.pi/council/scaffold-backups/
.pi/remote/
# Smoke test run artifacts (dot-dir so bun test never discovers them)
smoke/.artifacts/*
!smoke/.artifacts/.gitkeep

# git worktrees (superpowers isolation)
.worktrees/

# transient runner worktrees under the pi harness
.pi/worktrees/
